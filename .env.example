# ==============================================================================
# TREND STREET — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# WARNING: NEVER commit .env, .env.local, or actual production secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# The shop's public URL — used for canonical links, sitemap, structured data and share links.
NEXT_PUBLIC_SITE_URL="https://trendstreet.in"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL / Neon / Supabase)
# ------------------------------------------------------------------------------
# Pooled connection string for serverless queries (Port 6543 / PgBouncer):
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/[DBNAME]?sslmode=require&pgbouncer=true"
# Direct connection string for schema migrations (Port 5432):
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DBNAME]?sslmode=require"

# ------------------------------------------------------------------------------
# 3. ADMINISTRATIVE AUTHENTICATION & SESSION SECURITY  (all REQUIRED in production)
# ------------------------------------------------------------------------------
# The one email that can sign in to /admin. There are no built-in usernames or passwords.
ADMIN_EMAIL="owner@trendstreet.in"
# Recommended: a hash of the admin password. Generate it with:
#   npm run hash-password -- "your long admin password"
ADMIN_PASSWORD_HASH=""
# Alternative (if no hash is set): the plain password, at least 12 characters.
ADMIN_PASSWORD=""
# Session signing secret, at least 32 characters: openssl rand -hex 32
# Without it in production, nobody can sign in (admin or customer).
AUTH_SECRET="replace_with_output_of_openssl_rand_hex_32"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY — RAZORPAY (India / UPI / RuPay / Cards / Netbanking)
# ------------------------------------------------------------------------------
# Test keys start with rzp_test_ ; Live keys start with rzp_live_
RAZORPAY_KEY_ID="rzp_test_replace_with_key_id"
RAZORPAY_KEY_SECRET="replace_with_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="replace_with_razorpay_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_replace_with_key_id"

# The webhook (Razorpay Dashboard → Webhooks → https://<your-domain>/api/webhooks/payment,
# events: payment.captured, order.paid) must use the RAZORPAY_WEBHOOK_SECRET above.
# Daily reconciliation of unpaid orders (vercel.json cron). Vercel sends it as a Bearer token.
CRON_SECRET="replace_with_output_of_openssl_rand_hex_32"

# Safety Gate: Set to "true" ONLY in production with verified live credentials!
# Prevents accidental real charges during local dev or CI testing.
ALLOW_LIVE_PAYMENTS="false"

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY — STRIPE (NOT USED: the code has no Stripe integration)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_replace_with_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_stripe_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_with_stripe_pub_key"

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED RATE LIMITING (Upstash Redis REST - Optional / Recommended)
# ------------------------------------------------------------------------------
# When configured, rate limiting is distributed across all serverless regions.
# If omitted, a high-performance in-memory sliding-window limiter is used.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Set to "true" ONLY if all traffic reaches the site through Cloudflare; otherwise the
# cf-connecting-ip header can be forged to dodge rate limits.
TRUST_CLOUDFLARE_IP="false"

# ------------------------------------------------------------------------------
# 7. DOMESTIC SHIPPING & LOGISTICS (Shiprocket - India)
# ------------------------------------------------------------------------------
# If omitted or left as placeholder, the adapter operates in deterministic Sandbox Mock Mode.
SHIPROCKET_EMAIL="logistics@trendstreet.in"
SHIPROCKET_PASSWORD="replace_with_shiprocket_password"

# ------------------------------------------------------------------------------
# 8. TRANSACTIONAL EMAIL (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_replace_with_resend_api_key"
RESEND_FROM_EMAIL="Trend Street <orders@trendstreet.in>"
EMAIL_FROM="Trend Street <orders@trendstreet.in>"

# ------------------------------------------------------------------------------
# 9. OBJECT STORAGE — CLOUDFLARE R2 / AWS S3 (Garment Assets)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID="replace_with_cloudflare_account_id"
R2_ACCESS_KEY_ID="replace_with_r2_access_key"
R2_SECRET_ACCESS_KEY="replace_with_r2_secret_key"
R2_BUCKET_NAME="trend-street-production"
NEXT_PUBLIC_CDN_URL="https://assets.trendstreet.com"

# ------------------------------------------------------------------------------
# 10. MONITORING & OBSERVABILITY (Sentry)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
