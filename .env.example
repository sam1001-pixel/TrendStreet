# ==============================================================================
# OFFVYBE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Domain: offvybe.com
# Copy this file to .env.local for local development, or use as template for Hostinger .env
# WARNING: NEVER commit .env, .env.local, or actual production secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="https://offvybe.com"
NEXT_PUBLIC_SITE_URL="https://offvybe.com"
NEXT_PUBLIC_BASE_URL="https://offvybe.com"
NEXTAUTH_URL="https://offvybe.com"

# ------------------------------------------------------------------------------
# MongoDB Atlas: Use the direct replica-set format (non-SRV) on Linux/Hostinger to avoid resolv.conf errors:
# DATABASE_URL="mongodb://[USER]:[PASS]@[NODE-0]:27017,[NODE-1]:27017,[NODE-2]:27017/[DB]?ssl=true&replicaSet=[REPLICA_SET]&authSource=admin&retryWrites=true&w=majority"
DATABASE_URL="mongodb+srv://[USERNAME]:[PASSWORD]@[CLUSTER].mongodb.net/[DATABASE]?retryWrites=true&w=majority"


# ------------------------------------------------------------------------------
# 3. ADMINISTRATIVE AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@offvybe.com"
ADMIN_PASSWORD_HASH=""
AUTH_SECRET="replace_with_output_of_openssl_rand_hex_32"
SESSION_SECRET="replace_with_output_of_openssl_rand_hex_32"
CRON_SECRET="replace_with_output_of_openssl_rand_hex_32"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY — RAZORPAY (India / UPI / Cards / Netbanking)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_replace_with_key_id"
RAZORPAY_KEY_SECRET="replace_with_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="replace_with_razorpay_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_replace_with_key_id"
ALLOW_LIVE_PAYMENTS="false"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_replace_with_resend_api_key"
RESEND_FROM_EMAIL="OFFVYBE <orders@offvybe.com>"
EMAIL_FROM="OFFVYBE <orders@offvybe.com>"

# ------------------------------------------------------------------------------
# 6. ASSET & MEDIA STORAGE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CDN_URL="https://assets.offvybe.com"
BLOB_READ_WRITE_TOKEN=""

# ------------------------------------------------------------------------------
# 7. SHIPPING & LOGISTICS (Shiprocket - Optional)
# ------------------------------------------------------------------------------
SHIPROCKET_EMAIL="logistics@offvybe.com"
SHIPROCKET_PASSWORD="replace_with_shiprocket_password"
